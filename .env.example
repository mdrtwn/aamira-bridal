# Supabase project settings
# Copy this file to .env.local and replace both values from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional local prototype access. Never enable this in production.
DASHBOARD_DEV_AUTH=false
DASHBOARD_DEV_USERNAME=
DASHBOARD_DEV_PASSWORD=
